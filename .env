# SkyGuard AI — Local Environment Variables
# Paste your real API keys here (This file is in .gitignore and will NOT be uploaded to GitHub)

# 1. Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# 2. Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/live

# 3. Weather Provider APIs
# OpenWeatherMap API Key (Free from https://openweathermap.org/api)
VITE_OPENWEATHERMAP_API_KEY=98e21948af6d42ae40f5f3ae2896a54e
OPENWEATHERMAP_API_KEY=98e21948af6d42ae40f5f3ae2896a54e

# Open-Meteo (Free & Keyless by default)
VITE_OPENMETEO_API_KEY=
OPENMETEO_API_KEY=

# NOAA NWS Contact Header
VITE_NWS_USER_AGENT=SkyGuardAI/1.0 (contact@skyguard.ai)
NWS_USER_AGENT=SkyGuardAI/1.0 (contact@skyguard.ai)

# Meteoblue API Key (Optional)
VITE_METEOBLUE_API_KEY=OkgjbUc2TZlJuEin
METEOBLUE_API_KEY=OkgjbUc2TZlJuEin
