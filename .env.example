# SkyGuard AI — Environment Variables Template
# Copy to .env and fill in values before running

# ==========================================
# 1. Backend Server Configuration
# ==========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# ==========================================
# 2. Frontend Configuration (Vite)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/live

# ==========================================
# 3. Weather Provider APIs (Step 1)
# ==========================================
# Provider 1: OpenWeatherMap (https://openweathermap.org/api)
# Used for real-time observations, 5-day forecasts, and map tile layers (precipitation, clouds, temp, wind)
VITE_OPENWEATHERMAP_API_KEY=4ca6ac36ba32a4af0e14b478fdb4086a
OPENWEATHERMAP_API_KEY=4ca6ac36ba32a4af0e14b478fdb4086a

# Provider 2: Open-Meteo (https://open-meteo.com)
# Core endpoints are free & keyless. Leave blank unless using a paid/commercial API tier.
VITE_OPENMETEO_API_KEY=
OPENMETEO_API_KEY=

# Provider 3: National Weather Service / NOAA (https://www.weather.gov/documentation/services-web-api)
# NWS requires a descriptive User-Agent header with your application name and contact email (no API key required).
VITE_NWS_USER_AGENT=SkyGuardAI/1.0 (contact@skyguard.ai)
NWS_USER_AGENT=SkyGuardAI/1.0 (contact@skyguard.ai)

# Provider 4: Meteoblue (https://www.meteoblue.com/en/weather-api)
# Used for high-precision European & global numerical weather prediction data
VITE_METEOBLUE_API_KEY=your_meteoblue_api_key_here
METEOBLUE_API_KEY=your_meteoblue_api_key_here

# ==========================================
# 4. Alerting & Notifications (Optional)
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
