# SkyGuard AI — Environment Variables Template
# Copy to .env and fill in values before running

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# Frontend (Vite uses VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/live

# Optional: SMTP alerting stub
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
